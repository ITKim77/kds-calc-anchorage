{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(node .claude/hooks/*)",
      "Read(**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(PROGRESS.md)",
      "Edit(PLAN.md)",
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/bootstrap-check.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-verify.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-sync-check.mjs"
          }
        ]
      }
    ]
  }
}
